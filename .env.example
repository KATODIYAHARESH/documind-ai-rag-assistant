# ------------------------------------------------------------------
# DocuMind AI — environment template
# Copy to .env and fill in what you use. Never commit .env.
# ------------------------------------------------------------------

# Database (PostgreSQL). Stores users, documents, conversations and vectors.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- Answer generation (OpenAI-compatible chat completions) ----------
# Leave LLM_API_KEY empty to run in grounded extractive mode:
# answers are the most relevant sentences from your documents, quoted verbatim.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900

# ---- Embeddings ------------------------------------------------------
# EMBEDDING_PROVIDER: auto | openai | local
#   auto   -> OpenAI-compatible API when a key is present, otherwise the built-in offline embedder
#   local  -> built-in deterministic hashing-ngram embedder (no network, no downloads)
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_DIM=768

# ---- Retrieval -------------------------------------------------------
# Minimum relevance a passage must reach to be used (0-1). Empty = provider default (0.30).
RETRIEVAL_MIN_SCORE=

# ---- Uploads ---------------------------------------------------------
# Maximum size of a single PDF in bytes (default 15 MB).
MAX_UPLOAD_BYTES=15728640

# ---- Sessions --------------------------------------------------------
SESSION_TTL_DAYS=30
# Leave empty/unset: Secure + SameSite=None cookies are auto-detected from the request (HTTPS).
# Set to true only when a proxy terminates TLS without forwarding x-forwarded-proto.
COOKIE_SECURE=

# ---- OCR (reserved) --------------------------------------------------
OCR_ENABLED=false
